{
  "name": "@creo-team/action-release",
  "version": "0.2.2",
  "description": "World-class GitHub Action for automated releases with semantic versioning, LLM-powered release notes, codename generation, and more.",
  "main": "dist/index.js",
  "scripts": {
    "build": "ncc build src/index.ts -o dist --source-map --license licenses.txt",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit",
    "prepare": "npm run build",
    "all": "npm run typecheck && npm test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/creo-team/action-release.git"
  },
  "keywords": [
    "github-action",
    "release",
    "semantic-versioning",
    "changelog",
    "tagging",
    "llm",
    "codename",
    "conventional-commits"
  ],
  "author": "Creo Team",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/creo-team/action-release/issues"
  },
  "homepage": "https://github.com/creo-team/action-release#readme",
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/github": "^6.0.0",
    "@actions/glob": "^0.5.0",
    "unique-names-generator": "^4.7.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@vercel/ncc": "^0.38.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5",
    "@vitest/coverage-v8": "^3.0.5"
  }
}
